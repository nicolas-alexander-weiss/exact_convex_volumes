needs "determine_certificates.m2"
-- Now redo with quotient and remainder.

-- Try with some easy examples. E.g. in 1 variable_

D = makeWeylAlgebra(QQ[x,y], w = {1,1});
I = ideal(x*dx^2 - y*dy^2 + dx-dy, x*dx+y*dy+1);
GB = flatten entries gens gb I;

f = 2*I_0 + dx*I_1;

R = rationalWeylAlgebra D;

(Q,R) = extNormalForm(sub(f,R), GB)

