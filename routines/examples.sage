def unit_vector_examples_p2():
    """ For p=2, consider the setting of n unit balls in unit vector position in Rn.
    For this we place the n unit balls to be centered at each of the basis vectors.

    For n=1,2,3,4. (generating polynomials of degree 2,4,6,8. Which should still be feasible.)
    """

    p = 2
    prec = 200

    for n in [1,2,3,4]:
        print("[n={}, p={}] Starting computation of RR^{} case.".format(n,p,n))
        # mus are the rows of the identity matrix
        mus = [list(mu) for mu in np.identity(n, int)]
        print("[n={}, p={}] mus = {}".format(n, p, mus))

        S = PolynomialRing(QQ, "x", n)
        x = S.gens()

        fs = [shifted_lp_poly(S, p, mu) for mu in mus]

        print("[n={}, p={}] fs = {}".format(n, p, fs))

        print("[n={}, p={}] Starting intersection volume computation with prec = {} precision bits.".format(n, p, prec))

        vol = volume2(fs, prec, strategy=None)

        # TODO: Add intermediate steps in here!

        print("[n={}, p={}] vol = {}".format(n, p, vol))

        print("[n={}, p={}] End of computation of RR^{} case.\n".format(n,p,n))


def the_positive_dim_crit_locus_example():
    """ For the example of two l2 balls shifted by 1, one notices that the critical locus of the projection (of the the deformed intersection)
    onto the x0 axis is positive dimensional.
    """
    n = 4
    p = 2

    S = PolynomialRing(QQ, "x", n)
    x = S.gens()

    mus = [[0,0,0,0], [1,0,0,0]]

    fs = [shifted_lp_poly(S, p, mu) for mu in mus]
    def_value = QQ(0.001)
    F = eval_poly(deformed_product(fs, "t"), def_value)
    
    prec = 200

    proj_var = x[0]
    print("Trying to compute the relevant critical values of the projection onto the {}-axis:".format(proj_var))
    

    relevant_crit_vals = project_deformed_intersection(fs, def_value, proj_var, {}, prec=NUM_BITS_PRECISION)
    
    print("The relevant_crit_vals: ", relevant_crit_vals)

def example_translation_RR4():
    n = 4
    p = 2

    S = PolynomialRing(QQ, "x", n)
    x = S.gens()

    mus = [[0,0,0,0], [1,0,0,0]]

    fs = [shifted_lp_poly(S, p, mu) for mu in mus]

    print("Computing the volume of the intersection of two l2 balls in RR4 centered at {}".format(mus))
    prec = 200
    strategy={"proj_var":last_variable_proj_var_strategy}
    vol = volume2(fs, prec, strategy=strategy, debug_level=3)

    print("The volume = {}".format(vol))


